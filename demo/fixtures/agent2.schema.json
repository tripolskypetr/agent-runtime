{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/agent2.response.schema.json",
  "title": "Agent2Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluated_at",
    "signal_id",
    "precondition_checks",
    "entry_predicate_echo",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "evaluated_at": {
      "type": "string",
      "description": "ISO-8601 UTC, время тика"
    },
    "signal_id": {
      "type": "string",
      "minLength": 1
    },
    "precondition_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bars_available",
        "minutes_since_window_end",
        "no_open_position",
        "signal_not_expired",
        "features_sane"
      ],
      "properties": {
        "bars_available": {
          "type": "integer",
          "minimum": 0
        },
        "minutes_since_window_end": {
          "type": "number",
          "minimum": 0
        },
        "no_open_position": {
          "type": "boolean"
        },
        "signal_not_expired": {
          "type": "boolean"
        },
        "features_sane": {
          "type": "boolean"
        }
      }
    },
    "entry_predicate_echo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "leaf_results"
      ],
      "description": "эхо входных данных; агент обязан воспроизвести их без изменений",
      "properties": {
        "value": {
          "type": "boolean"
        },
        "leaf_results": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "feature",
              "op",
              "value",
              "observed",
              "result"
            ],
            "properties": {
              "feature": {
                "type": "string"
              },
              "op": {
                "type": "string"
              },
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "observed": {
                "type": "number"
              },
              "result": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "veto_reason",
        "notes"
      ],
      "properties": {
        "action": {
          "enum": [
            "open_long",
            "hold_flat"
          ]
        },
        "veto_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "insufficient_bars",
            "stale_data",
            "position_already_open",
            "signal_expired",
            "feature_anomaly",
            null
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "entry_predicate_echo": {
            "properties": {
              "value": {
                "const": false
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "entry_predicate_echo"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "action": {
                "const": "hold_flat"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "action": {
                "const": "open_long"
              }
            },
            "required": [
              "action"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "veto_reason": {
                "type": "null"
              }
            }
          },
          "precondition_checks": {
            "properties": {
              "no_open_position": {
                "const": true
              },
              "signal_not_expired": {
                "const": true
              },
              "features_sane": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}