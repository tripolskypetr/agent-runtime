{
  "compilerOptions": {
    "rootDir": "./src/",
    "baseUrl": "./",
    "lib": [
      "esnext",
      "dom"
    ],
    "types": ["node"],
    "moduleDetection": "force",
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "downlevelIteration": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "./src"
  ]
}
