{
  "name": "agent-runtime",
  "version": "0.1.0",
  "description": "REST API harness for a pi-based AI agent on Ollama: structured JSON answers via provide_answer tool calling, plain text answers, bash and image tools in an isolated data workspace, SQLite history, admin UI and Swagger. Ships as a self-contained Docker image.",
  "keywords": [
    "ai-agent",
    "agent-harness",
    "llm",
    "ollama",
    "pi",
    "pi-agent-core",
    "tool-calling",
    "function-calling",
    "structured-output",
    "json-schema",
    "json-inference",
    "generateObject",
    "generateText",
    "rest-api",
    "fastify",
    "swagger",
    "openapi",
    "sqlite",
    "node-sqlite",
    "docker",
    "bash-tool",
    "vision",
    "multimodal",
    "typescript"
  ],
  "author": {
    "name": "Petr Tripolsky",
    "email": "tripolskypetr@gmail.com",
    "url": "https://github.com/tripolskypetr"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tripolskypetr/agent-runtime"
  },
  "homepage": "https://github.com/tripolskypetr/agent-runtime#readme",
  "bugs": {
    "url": "https://github.com/tripolskypetr/agent-runtime/issues"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env ./build/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "smoke": "tsx demo/smoke.ts",
    "publish:win": "npm run build && .\\scripts\\win\\publish.bat",
    "publish:x": "npm run build && sh ./scripts/linux/publish.sh",
    "build:sdk": "npm --prefix packages/sdk run build",
    "test:sdk": "npm --prefix packages/sdk test",
    "test:schema": "tsx demo/schema.test.ts",
    "smoke:schema": "tsx demo/smoke-schema.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@fastify/static": "10.1.8",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "5.12.7",
    "functools-kit": "5.0.0",
    "mustache": "4.2.0",
    "ollama": "^0.6.4",
    "pinolog": "^1.1.1"
  },
  "devDependencies": {
    "@types/mustache": "4.2.6",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
