# --- Ollama inference -------------------------------------------------------
# Cloud: https://ollama.com with a key from https://ollama.com/settings/keys
# Local: OLLAMA_HOST=http://host.docker.internal:11434 and an empty key
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b-cloud
# 1 = send images to the model (vision), 0 = text-only model; images stay available as files in the workspace
OLLAMA_VISION=1
# thinking is off by default; true to enable, or low/medium/high for models that support effort levels (empty = model default)
OLLAMA_THINK=false
# optional: context window and temperature passed to Ollama
OLLAMA_NUM_CTX=
# optional: cap on generated tokens per model call (protects against run-away text answers)
OLLAMA_NUM_PREDICT=
OLLAMA_TEMPERATURE=

# --- Harness limits ---------------------------------------------------------
# re-prompts demanding provide_answer when the model answers with text (as in json-inference)
MAX_ATTEMPTS=3
# model calls per inference before giving up
MAX_TURNS=40
INFERENCE_TIMEOUT_MS=900000
BASH_TIMEOUT_SEC=120
BASH_MAX_OUTPUT_BYTES=51200
BASH_MAX_OUTPUT_LINES=2000
# request body limit (base64 images and files)
BODY_LIMIT_MB=256

# --- Logging ----------------------------------------------------------------
# ./logs/debug.log (JSON lines via pinolog, rotated at 100 MB): every request, agent turn, tool call and error
LOGS_ENABLED=1
LOGS_DIR=./logs
LOG_FILE=debug.log
# echo of the debug log to stdout (docker compose logs): all | warn | off
LOG_CONSOLE=all
# Fastify request log level on stdout: trace | debug | info | warn | error
LOG_LEVEL=info
